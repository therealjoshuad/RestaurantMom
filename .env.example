# Copy to .env.local (Next.js) and fill in. Never commit real keys.
# Neon connection string (Connect dialog in the Neon console). Needs a real ":" and "@".
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
EXA_API_KEY=
# Neon AI Gateway: bare branch host (no path). The app appends /v1.
NEON_AI_GATEWAY_BASE_URL=https://BRANCH_ID-api.ai.REGION.aws.neon.tech
NEON_AI_GATEWAY_TOKEN=
# Gateway model id, no provider prefix (e.g. claude-sonnet-4-6)
MODEL=claude-sonnet-4-6
# Shared password for the login page, and a random secret (e.g. `openssl rand -hex 32`) to sign the session cookie.
APP_PASSWORD=
AUTH_SECRET=
