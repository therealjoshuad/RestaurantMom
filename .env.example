# Copy to .env.local (Next.js) and fill in. Never commit real keys.
DATABASE_URL=postgres://USER:PASS@HOST.neon.tech/neondb?sslmode=require
EXA_API_KEY=
# Any Mastra model string, e.g. anthropic/claude-sonnet-4-5 (check Mastra's model list)
MODEL=anthropic/claude-sonnet-4-5
# Key for whichever provider MODEL uses (or the Neon AI Gateway key/base URL from their docs)
ANTHROPIC_API_KEY=
